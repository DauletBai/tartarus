on": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6424, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6425, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6426, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6427, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6428, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6429, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6430, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6431, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6432, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6433, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6434, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6435, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6436, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6437, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}, {"page": 0, "number": 6438, "suffix": "", "reference": "", "newEdition": "", "secondaryLiterature": "", "museumNumber": null, "cdliNumber": "", "externalProject": "", "notes": "", "date": "", "transliteration": "", "sign": ""}], "mesZl": "140\t**ZI**\t𒍣\t→ Kap. VII\nASy 59. Lww. zi/e (allg:) — ṣí/ṣé (üw. a.) — sí/é (üw. a.).\n---\nzi = *napištu*, *napuš*/*ltu*, Seele, Leben. 𒍣𒁴 = zi-*tim* kommt wohl als logographische Einheit vor (vgl. n737 ki-*tim*); cf ASy n68 sub *tì*. ^I^𒌓𒍣 siehe n596.\nzi, zìg = *nasāḫu*, ausreissen; *nasḫu*, ausgerissen. Mathematisch *nasāḫu* = abziehen, Thureau-D., TMB p233f., CAD N/II 9b; auch ba-zi.\nzi = *nīš*, (beschwören) bei, von *nīšu* = Leben.\nZI =^?^ *sikkat ṣēli* (wohl Abkürzung *sí*, Nougayrol, RA 44 21f., CAD S 246f.).\nzi, zìg und 𒍣𒂵 = zi-ga = *tebû*, sich erheben, auch AHw 1343b und CAD T 321f. tēbû; *tību*, Erhebung, Angriff. zi-ga oder zi-*bu* + 𒁉𒁺 = *t. kaš-du*, erfolgreicher Angriff. zi-*ut* = *tibû-ut*, Erhebung, Angriff von.\n𒍣𒋻𒊏𒁕/𒉈 = zi-ku₅-ru-da/dè = *zikurudû*, eine Art Zauber (wechselt bei Mayer, OrNS 62 322 108 mit *nikis napišti*, Halsabschneidung: cf Farber, BID 247f.).\n^mul^𒍣𒁀𒀭𒈾 = zi-ba-an-na = *zibānītu*, Libra (Gössmann n176). Zu [z]i-ba-an-na = *zibānītu* bei Borger, BiOr 28 7 I 14’ cf AHw 1523b Mitte.\n(^giš^)𒍣𒈾 = zi-na = *zinû*, ein Teil der Dattelpalme.\n(^munus^)𒍣𒅅𒊒𒌝 = sé-ek-ru-um = *sekretu*, “Abgesperrte”, eine Frauenklasse (CAD S 215ff.).\n^lú^𒍣𒍣 = zi-zi = *dēkû*, Nachtwächter.\n𒍣𒄥^ku₆^ = zi-gur = *singurru*, ein Fisch.\n^giš^𒍣𒃶 = zi-gan = *sikkānu*, Steuerruder (Schramm, OrNS 43 163).\n𒍣𒅔𒄀 = zi-in-gi = *kiṣallu*, Knöchel.\n𒍣𒅕 = zi-ir = *ašāšu*, sich betrüben; *ašuštu*, Trübsal.\n𒍣𒅕𒁺, 𒍣𒅕𒁺𒌝, 𒍣𒅕𒌈 = zi-ir-du/du-um//dum siehe CAD S 311f., AHw 1037a-b.\n𒍣𒂵 = zi-ga = *ṣītu*, Verlust (Farber, BID 76).\n𒍣𒂵 = zi-ga = *tebû* usw., siehe oben.\n^na₄^𒍣𒂍 = *zi-bītu*, ein Stein (AHw 1524b Mitte, CAD Z 104, Köcher, AfO 20 157, Borger, Fs. Lambert 89f. 87).\n𒄑𒍣 siehe n469.\n𒍣𒌓𒋤𒊏 u.ä. = zi-ud/u₄-sud-ra (Xisuthros), Literatur siehe n596 𒌓𒍣.\n𒀉𒍣𒂵 siehe n560.\n𒃻𒍣 = níg-zi/zid = *kīttu*, Recht.\n𒃻𒍣𒅕 = níg-zi-ir = *ašuštu*, Trübsal.", "LaBaSi": "228", "reverseOrder": "", "unicode": [74595], "sortKeys": {"neoAssyrianOnset": [145], "neoBabylonianOnset": [58], "neoAssyrianOffset": [124], "neoBabylonianOffset": [233]}, "name": "ZI"}